    {
      "n": 82,
      "file": "082",
      "title": "袁安別系<所見莢繪，必有此力量始可也。推之庶政，皆冝若是>",
      "has_json": false
    },
    {
      "n": 83,
      "file": "083",
      "title": "高柔察色<此正聽五詞之一驗也。惟虛心以待之，則情狀可見>",
      "has_json": false
    },
    {
      "n": 84,
      "file": "084",
      "title": "崔公仁恕<必養得此等志量，然後可決大獄、臨大事>",
      "has_json": false
    },
    {
      "n": 85,
      "file": "085",
      "title": "李嶠列枉<此等胸襟，亦不可不預養>",
      "has_json": false
    },
    {
      "n": 86,
      "file": "086",
      "title": "唐臨不寃<如此治獄，固季路之儔也。真可為法>",
      "has_json": false
    },
    {
      "n": 87,
      "file": "087",
      "title": "真卿感雨<雨否固在天，然由此觀之，其辯獄必能平允，固冝師其辯不必其雨>",
      "has_json": false
    },
    {
      "n": 88,
      "file": "088",
      "title": "崔碣霽潦<霽潦之事與雨相似，崔公之明，自是當傳也>",
      "has_json": false
    },
    {
      "n": 89,
      "file": "089",
      "title": "陳襄捫鐘<此事亦人所共傳，雖未可為常，然仿此推類用心，亦詰奸之一助也>",
      "has_json": false
    },
    {
      "n": 90,
      "file": "090",
      "title": "劉敞察寃<辯析於似是之間，非至明，其孰能之>",
      "has_json": false
    },
    {
      "n": 91,
      "file": "091",
      "title": "呂陶服罪<天理之在人心，固未嘗泯也。然呂公必能心誠論之，自是感發也>",
      "has_json": false
    },
    {
      "n": 92,
      "file": "092",
      "title": "濂溪悟酷<此事已載各史，夫人皆知之。今贅錄，誠慕其胸次之正未易及也>",
      "has_json": false
    },
    {
      "n": 93,
      "file": "093",
      "title": "張洽服盜<此等事，固所願學也，而不可及。誠以動物，張公亦庶幾乎>",
      "has_json": false
    },
    {
      "n": 94,
      "file": "094",
      "title": "哈雅釋孝<此亦恒有之，如此試驗亦易，然其事可為人子勸也>",
      "has_json": false
    },
    {
      "n": 95,
      "file": "095",
      "title": "德輝察寃<此事亦世所有，頋主刑者用心何如耳>",
      "has_json": false
    },
    {
      "n": 96,
      "file": "096",
      "title": "田滋得稿<此事雖不可為常法，然可見田公之用心也。主刑者恒存此心，庶幾公平也夫>",
      "has_json": false
    },
    {
      "n": 97,
      "file": "097",
      "title": "澤民訊僧<此非用心切至者不能有。官君子庸可少忽乎>",
      "has_json": false
    },
    {
      "n": 98,
      "file": "098",
      "title": "清獻原情<理法只在目前，趙公能發明之>",
      "has_json": false
    },
    {
      "n": 99,
      "file": "099",
      "title": "承議持平<鄭公此事似若易及，然非秉心之公不能>",
      "has_json": false
    },
    {
      "n": 100,
      "file": "100",
      "title": "提舉辯明<明慎如楊公，可不儀式乎>",
      "has_json": false
    },
    {
      "n": 101,
      "file": "101",
      "title": "陳睦酷報<睦事未可謂無，錄之為酷吏儆>",
      "has_json": false
    },
    {
      "n": 102,
      "file": "102",
      "title": "安禮神明<王公固明敏，然非用心何以能此>",
      "has_json": false
    },
    {
      "n": 103,
      "file": "103",
      "title": "文原雨旱<鄧公蓋明達者邪，辯析之精，可為法也>",
      "has_json": false
    },
    {
      "n": 104,
      "file": "104",
      "title": "師泰折獄<貢公亦善於推鞫矣，詞雖煩而事可取，敢並錄之>",
      "has_json": false
    },
